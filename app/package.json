{
  "name": "damark-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node server/build.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p server --noEmit && tsc -p web --noEmit",
    "test": "node --import tsx --test server/test/*.test.ts",
    "user": "node dist/server/cli.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
